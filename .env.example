# Used only by docker-compose.yml to pass build-time arguments to the
# admin frontend image (Vite bakes these into the built bundle, so they
# must be known at build time). Copy this to ".env" at the repo root.
# These should match managecancellations-admin-main/.env.example.
VITE_BASE_URL=http://localhost:8033/
VITE_APP_TITLE=Athena EHR Backoffice
VITE_PORT=8034
