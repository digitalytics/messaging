# This root .gitignore covers folders that live outside the two app
# subprojects (each of which already has its own .gitignore), plus a
# safety net in case a repo is ever initialized here directly.

# Local-only artifacts, not part of the app
dump/
report/
.playwright-mcp/

# Dependencies
node_modules/
**/node_modules/

# Environment files (never commit real secrets)
.env
**/.env
.env.local
.env.*.local

# Build output
dist/
**/dist/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

.claude
test-portal/