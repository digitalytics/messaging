# URL the browser uses to reach the backend API. Must be a host-reachable
# URL (not a Docker service name), since this runs in the user's browser,
# not inside the Docker network. Keep the trailing slash.
VITE_BASE_URL=http://localhost:8033/

VITE_APP_TITLE=Athena EHR Backoffice

# Port the app listens on. 8034 is the Docker/production default (served by
# app.js). For local `npm run dev` you may prefer 5173, Vite's usual port.
VITE_PORT=8034
