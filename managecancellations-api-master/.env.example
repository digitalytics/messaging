DEFAULT_LANGUAGE=EN
NODE_ENV=production
HOST=0.0.0.0
PORT=8033

# In Docker Compose, MONGO_HOST must be the service name "mongo".
# For local (non-Docker) dev, use 127.0.0.1 (or your Mongo host).
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=mongo
MONGO_PORT=27017
DATABASE_NAME=managecancellations

# Unused placeholders. The app's startup check requires these keys to be
# present, but no AWS service is actually called; any non-empty value works.
AWS_ACCESS_KEY_ID=dummy
AWS_ACCESS_SECRET_KEY=dummy
AWS_REGION=us-east-1
AWS_SES_REGION=us-east-1
AWS_SNS_REGION=us-east-1
AWS_PREFIX=dev
AWS_FOLDER_PREFIX=dev-
AWS_FOLDER_NAME=dev-folder
AWS_S3_BUCKET_NAME=dummy-bucket

# Gmail OAuth2 credentials used to send notification emails via Nodemailer.
GMAIL_USER=changeme@example.com
GMAIL_CLIENT_ID=changeme
GMAIL_CLIENT_SECRET=changeme
GMAIL_REFRESH_TOKEN=changeme

# Used to sign admin session tokens. Set this to a long random string.
JWT_SECRET=changeme

# Athena Health API credentials (sandbox or production, per your account).
ATHENA_CLIENT_ID=changeme
ATHENA_CLIENT_SECRET=changeme
ATHENA_BASE_URL=https://api.preview.platform.athenahealth.com
ATHENA_PRACTICE_ID=changeme
